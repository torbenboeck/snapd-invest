{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push origin :*)",
      "Bash(git push * :*)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(git branch -D develop)",
      "Bash(git branch -d main)",
      "Bash(git branch -d master)",
      "Bash(git branch -d develop)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:* --visibility:*)",
      "Bash(gh api * -X DELETE:*)",
      "Bash(rm -rf .git:*)",
      "Bash(rm -rf /:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git reset --hard origin/main)",
      "Bash(git reset --hard origin/master)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr create:*)",
      "Bash(rm -rf:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(alembic downgrade:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_bash.py\""
          }
        ]
      }
    ]
  }
}
