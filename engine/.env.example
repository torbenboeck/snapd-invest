# Copy to engine/.env (gitignored) and fill in.

# Database
SNAPDINVEST_DB_PATH=./data/snapd_invest.db

# Logging
SNAPDINVEST_LOG_LEVEL=INFO
SNAPDINVEST_LOG_FORMAT=console   # console | json

# API
SNAPDINVEST_API_HOST=127.0.0.1
SNAPDINVEST_API_PORT=8000

# LLM (Ollama, used by agents)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Saxo (not used at MVP)
# SAXO_ENV=sim           # sim | live
# SAXO_CLIENT_ID=
# SAXO_CLIENT_SECRET=
