# Copy to engine/.env (gitignored) and fill in.

# Database
ALGOINVEST_DB_PATH=./data/algo_invest.db

# Logging
ALGOINVEST_LOG_LEVEL=INFO
ALGOINVEST_LOG_FORMAT=console   # console | json

# API
ALGOINVEST_API_HOST=127.0.0.1
ALGOINVEST_API_PORT=8000

# LLM (Ollama, used by agents)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Saxo (not used at MVP)
# SAXO_ENV=sim           # sim | live
# SAXO_CLIENT_ID=
# SAXO_CLIENT_SECRET=
