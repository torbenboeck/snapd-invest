<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-local NuGet config. Pins the .NET CLI to nuget.org only so it does
    not inherit work/personal feeds from the developer's global config
    (Optimizely, TeliaCompany GitHub Packages, etc.). Central Package
    Management requires either a single source or explicit source mapping,
    and we want a single source for an open public dependency set.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
