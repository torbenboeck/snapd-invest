<Project>

  <!--
    Solution-wide build settings for the .NET CLI projects.
    These apply to every .csproj under cli/ unless explicitly overridden.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- IDE0005 (remove unused usings) requires the XML doc file to be
         generated; CS1591 (missing XML doc) is suppressed to keep us free
         of doc-comment ceremony. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Company>snapd-invest</Company>
    <Authors>Torben Boeck</Authors>
    <Copyright>Copyright © Torben Boeck</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
